{
  "schema": "site-plan/1",
  "name": "Small temple complex (example)",
  "units": "m",
  "axes": "plan points are [x, z]; x east, z south, y up (three.js). Blender: bx = x, by = -z, bz = y",
  "site": {
    "bounds": [-40, -30, 40, 30],
    "ground_y": 0,
    "grid": 0.5,
    "north": "-z",
    "notes": "Flat site. South gate at z=+30, main hall at the north end."
  },
  "style": {
    "era": "Japanese Buddhist temple, wooden, Edo-period feel (stylised, not a copy of one real temple)",
    "palette": {
      "vermilion": "#c8402a",
      "gold_trim": "#c9a227",
      "aged_wood": "#5a3a24",
      "white_plaster": "#efe9dc",
      "roof_tile": "#3b4048",
      "gravel": "#d8d3c8",
      "sakura": "#f4c6d2"
    },
    "rules": [
      "Every structure sits on a stone podium or the ground; nothing floats.",
      "Roof eaves overhang their walls; overhang is part of the element height/footprint budget only through the podium, never into a neighbour.",
      "Repeated parts (lanterns, rafters, bracket sets, tiles, petals) are instanced."
    ]
  },
  "shared_files": [
    {"path": "src/shared/materials.js", "owner": "lead", "note": "palette materials, read-only for zone agents"},
    {"path": "src/shared/kit.js", "owner": "lead", "note": "helpers: podium(), roofTier(), lantern(), sakura(); read-only"},
    {"path": "src/main.js", "owner": "lead", "note": "loads every zone module, camera, lights"}
  ],
  "zones": [
    {"id": "approach", "owner": "agent-approach", "bbox": [-40, 10, 40, 30],
